# =====================================================
# SUPABASE - Configurações do Banco de Dados
# =====================================================

# URL do projeto Supabase
# Encontre em: https://app.supabase.com/project/SEU_PROJETO/settings/api
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Chave pública (anon public key)
# Encontre em: https://app.supabase.com/project/SEU_PROJETO/settings/api
VITE_SUPABASE_ANON_KEY=sua_chave_publica_aqui

# =====================================================
# NOTAS DE SEGURANÇA
# =====================================================
# 
# ✅ A chave do Gemini AI está configurada como Secret no Supabase
